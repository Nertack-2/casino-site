<%- include('partials/header') %>

<div class="row mt-5">
    <div class="col-md-6">
        <% if (game.image) { %>
            <img src="<%= game.image %>" class="img-fluid rounded border border-warning" alt="<%= game.title_en %>">
        <% } %>
    </div>
    <div class="col-md-6">
        <h2 class="text-warning"><%= lang === 'ru' ? game.title_ru : game.title_en %></h2>
        <p class="lead"><%= lang === 'ru' ? game.description_ru : game.description_en %></p>

        <div class="card bg-dark border-secondary mt-4 mb-4">
            <div class="card-body">
                <h5 class="text-light">RTP (Return to Player)</h5>
                <h3 class="text-success"><%= game.rtp %>%</h3>
            </div>
        </div>

        <button class="btn btn-warning btn-lg text-dark fw-bold w-100">Play Now / Играть сейчас</button>

        <a href="/games" class="btn btn-outline-secondary w-100 mt-3">
            <%= lang === 'ru' ? 'Вернуться к списку игр' : 'Back to games' %>
        </a>
    </div>
</div>

<%- include('partials/footer') %>