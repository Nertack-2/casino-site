<%- include('partials/header') %>

<div class="row justify-content-center mt-5">
    <div class="col-md-6">
        <div class="card bg-dark border-warning shadow-lg">
            <div class="card-body p-5">
                <h2 class="text-warning text-center mb-4">Вход / Login</h2>
                <form action="/auth/login" method="POST">
                    <div class="mb-3">
                        <label class="form-label text-light">Email</label>
                        <input type="email" name="email" class="form-control bg-dark text-light border-secondary" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-light">Пароль / Password</label>
                        <input type="password" name="password" class="form-control bg-dark text-light border-secondary" required>
                    </div>
                    <button type="submit" class="btn btn-warning w-100 fw-bold text-dark mt-3">Войти / Login</button>
                </form>
                <div class="text-center mt-3">
                    <small class="text-muted">Нет аккаунта? <a href="/auth/register" class="text-warning">Зарегистрируйтесь</a></small>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('partials/footer') %>