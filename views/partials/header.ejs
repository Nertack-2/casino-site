<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Casino Royale</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body class="bg-dark text-light">
    <nav class="navbar navbar-expand-lg navbar-dark bg-black border-bottom border-warning mb-4">
        <div class="container">
            <a class="navbar-brand text-warning fw-bold" href="/">🎰 CASINO ROYALE</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto align-items-center">
                    <li class="nav-item">
                        <a class="nav-link" href="/"><%= t.nav.home %></a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/games"><%= t.nav.games %></a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/bonuses"><%= t.nav.bonuses %></a>
                    </li>

                    <!-- Блок пользователя -->
                    <% if (user) { %>
                        <li class="nav-item">
                            <span class="nav-link text-success fw-bold">👤 <%= user.username %> | $<%= user.balance %></span>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-danger" href="/auth/logout">Logout</a>
                        </li>
                    <% } else { %>
                        <li class="nav-item">
                            <a class="nav-link text-warning" href="/auth/register">Register / Регистрация</a>
                        </li>
                    <% } %>

                    <!-- Переключатель языков -->
                    <li class="nav-item ms-3">
                        <a class="btn btn-sm btn-outline-warning" href="/lang/en">EN</a>
                        <a class="btn btn-sm btn-outline-warning" href="/lang/ru">RU</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
    <main class="container">